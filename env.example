# Copiar a .env  ->  cp env.example .env  (y rellenar)
# El .env NO va a git: es el único lugar donde viven los secretos.

# ─── App ───────────────────────────────────────────────
API_DOMAIN=api.tudominio.com
# Repo del paquete en GHCR: <owner>/<repo>/api
GHCR_REPO=OWNER/REPO/api

# Orígenes del front permitidos por CORS (coma como separador).
# Sin esto, el browser bloquea cada fetch del front al back.
CORS_ORIGINS=https://tudominio.com,https://www.tudominio.com

# ─── Módulos ───────────────────────────────────────────
# Apagar un módulo saca sus endpoints y sus beans (las migraciones corren igual).
MODULE_BLOCKCHAIN=true
MODULE_AI=true
MODULE_GEO=true

# ─── Módulo IA (DeepInfra) ─────────────────────────────
# Key en https://deepinfra.com/dash/api_keys — sin esto /ai/* responde 503.
DEEPINFRA_API_KEY=
# La API es compatible con OpenAI: apuntá base-url a OpenRouter, Together,
# vLLM o un Ollama local y el mismo código sirve.
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
AI_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct
# 1024 dimensiones: tiene que coincidir con VECTOR(1024) en V4__ai.sql.
AI_EMBEDDING_MODEL=BAAI/bge-m3

# ─── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=hack
# Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=hack

# ─── Datos en disco (ruta del HOST) ────────────────────
# Convención del server: /srv/<proyecto>/
PGDATA_DIR=/srv/hack/pgdata
